---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ghistory — not found">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="text-xl font-medium">404</h1>
    <p class="mt-2 text-sm text-muted">Nothing was recorded at this path.</p>
    <a href={import.meta.env.BASE_URL} class="mt-6 inline-block text-sm text-accent underline">
      back to the feed
    </a>
  </div>
</Layout>
