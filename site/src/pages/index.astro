---
import Layout from '../layouts/Layout.astro';
import Calendar from '../components/Calendar.astro';
import ReportCard from '../components/ReportCard.astro';
import { getReportsByMonth, getDailyActivity } from '../lib/history';
import { buildCalendar } from '../lib/calendar';

const months = await getReportsByMonth();
const activity = await getDailyActivity();
const calendarMonths = buildCalendar(activity);
---

<Layout>
  <div class="border-b border-hairline">
    <div class="mx-auto max-w-6xl px-4 py-5 flex items-center justify-between gap-4">
      <div>
        <h1 class="text-xl font-medium">ghistory</h1>
        <p class="text-xs text-muted mt-0.5">
          A daily, permanent record of how the GitHub ecosystem changes.
        </p>
      </div>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        title="Switch theme"
        class="shrink-0 p-2 rounded-md text-muted hover:text-ink border border-hairline cursor-pointer"
      >
        <svg
          class="w-4 h-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg
          class="w-4 h-4 hidden dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-8 lg:flex lg:gap-10 lg:items-start">
    <aside class="lg:w-52 lg:shrink-0">
      <div class="lg:sticky lg:top-8">
        <Calendar months={calendarMonths} />
      </div>
    </aside>

    <main class="lg:flex-1 min-w-0 mt-8 lg:mt-0">
      {
        months.map((month, i) => (
          <details id={`month-${month.key}`} class="scroll-mt-6 mb-2" open={i === 0}>
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 py-2 border-b-2 border-hairline">
              <span class="flex items-baseline gap-3">
                <span class="text-lg font-display font-medium">{month.label}</span>
                <span class="text-xs text-muted">{month.reports.length} days recorded</span>
              </span>
              <span
                class:list={[
                  'text-sm font-medium',
                  month.netStars >= 0 ? 'text-green' : 'text-muted'
                ]}
              >
                {month.netStars >= 0 ? '+' : ''}
                {month.netStars.toLocaleString()} net
              </span>
            </summary>
            {month.reports.map(({ date, entry }) => (
              <ReportCard date={date} entry={entry} activity={activity.get(date) ?? null} />
            ))}
          </details>
        ))
      }
    </main>
  </div>
</Layout>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
